---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationVisual from "../components/PublicationVisual.astro";
import { publications, featuredPublications } from "../data/site";

const description =
  "Browse Katsevich Lab publications in Perturb-seq analysis and statistics for reliable discovery, with plain-language summaries, paper links, software, and reproducible code.";
const themes = ["All", "Perturb-seq", "Reliable discovery"];
const statuses = ["All", "Working manuscript", "Under review", "Published"];
---

<BaseLayout title="Publications" description={description}>
  <header class="page-hero page-hero--publications">
    <div class="shell page-title-grid">
      <div>
        <p class="eyebrow">Publications</p>
        <h1>Ideas, evidence, and <em>open outputs.</em></h1>
      </div>
      <p class="page-lede">Our selected papers span two connected directions: Perturb-seq from design to discovery, and statistics for reliable discovery. Each entry explains the scientific problem and main idea in plain language, then links the paper to software and reproducible code where available.</p>
    </div>
  </header>

  <section class="section featured-publications-section">
    <div class="shell">
      <div class="people-section-heading"><p class="eyebrow">Featured work</p><h2>A few places to begin</h2></div>
      <div class="publication-feature-grid">
        {featuredPublications.map((paper, index) => (
          <article class="publication-feature-card">
            <PublicationVisual motif={paper.visual.motif} seed={paper.visual.seed} />
            <div class="publication-feature-meta"><span>0{index + 1}</span><span>{paper.year} · {paper.status}</span></div>
            <h3>{paper.title}</h3>
            <p class="publication-authors">{paper.authors}</p>
            <p>{paper.summary}</p>
            <div class="text-links">
              {paper.links?.map((link) => <a href={link.href}>{link.label}<span aria-hidden="true"> ↗</span></a>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section publication-index-section">
    <div class="shell">
      <div class="publication-index-heading">
        <div><p class="eyebrow">Publication list</p><h2>Selected {publications.length} works</h2></div>
        <div class="publication-index-meta">
          <p id="publication-count" aria-live="polite">Showing all {publications.length} selected works</p>
          <a href="/files/CV_Eugene_Katsevich.pdf">Full CV <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="publication-controls" aria-label="Publication filters">
        <fieldset>
          <legend>Research direction</legend>
          <div class="filter-row" data-filter-group="theme">
            {themes.map((theme, index) => <button type="button" data-value={theme} aria-pressed={index === 0 ? "true" : "false"}>{theme}</button>)}
          </div>
        </fieldset>
        <fieldset>
          <legend>Status</legend>
          <div class="filter-row" data-filter-group="status">
            {statuses.map((status, index) => <button type="button" data-value={status} aria-pressed={index === 0 ? "true" : "false"}>{status}</button>)}
          </div>
        </fieldset>
      </div>

      <div class="publication-list" id="publication-list" data-publication-total={publications.length}>
        {publications.map((paper, index) => (
          <article class="publication-item" data-themes={paper.themes.join(",")} data-status={paper.status}>
            <div class="publication-number">{String(publications.length - index).padStart(2, "0")}</div>
            <PublicationVisual motif={paper.visual.motif} seed={paper.visual.seed} compact />
            <div>
              <div class="publication-meta"><span>{paper.year}</span>{paper.themes.map((theme) => <span>{theme}</span>)}<span>{paper.status}</span></div>
              <h3>{paper.title}</h3>
              <p class="publication-authors">{paper.authors}</p>
              <p class="publication-venue">{paper.venue}</p>
              <p class="publication-summary">{paper.summary}</p>
              {paper.links && (
                <div class="text-links">
                  {paper.links.map((link) => <a href={link.href}>{link.label}<span aria-hidden="true"> ↗</span></a>)}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
      <p id="publication-empty" class="publication-empty" hidden>No publications match these filters.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const groups = document.querySelectorAll<HTMLElement>("[data-filter-group]");
  const items = [...document.querySelectorAll<HTMLElement>(".publication-item")];
  const count = document.querySelector<HTMLElement>("#publication-count");
  const empty = document.querySelector<HTMLElement>("#publication-empty");
  const state = { theme: "All", status: "All" };

  const update = () => {
    let visible = 0;
    items.forEach((item) => {
      const show =
        (state.theme === "All" || item.dataset.themes?.split(",").includes(state.theme)) &&
        (state.status === "All" || item.dataset.status === state.status);
      item.hidden = !show;
      if (show) visible += 1;
    });
    if (count) count.textContent = visible === items.length ? `Showing all ${visible} selected works` : `Showing ${visible} of ${items.length} works`;
    if (empty) empty.hidden = visible !== 0;

    const params = new URLSearchParams();
    if (state.theme !== "All") params.set("theme", state.theme);
    if (state.status !== "All") params.set("status", state.status);
    history.replaceState(null, "", params.size ? `${location.pathname}?${params}` : location.pathname);
  };

  const params = new URLSearchParams(location.search);
  (["theme", "status"] as const).forEach((key) => {
    const value = params.get(key);
    const group = document.querySelector<HTMLElement>(`[data-filter-group="${key}"]`);
    const button = group?.querySelector<HTMLButtonElement>(`button[data-value="${CSS.escape(value ?? "")}"]`);
    if (value && button) {
      state[key] = value;
      group?.querySelectorAll("button").forEach((candidate) => candidate.setAttribute("aria-pressed", "false"));
      button.setAttribute("aria-pressed", "true");
    }
  });

  groups.forEach((group) => {
    group.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("button[data-value]");
      if (!button) return;
      const key = group.dataset.filterGroup as "theme" | "status";
      state[key] = button.dataset.value ?? "All";
      group.querySelectorAll("button").forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
      update();
    });
  });

  update();
</script>
