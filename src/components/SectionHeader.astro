---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: "left" | "split";
}

const { eyebrow, title, text, align = "left" } = Astro.props;
---

<div class:list={["section-header", `section-header--${align}`]}>
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
  </div>
  {text && <p>{text}</p>}
</div>
